# Normalize line endings in repo to LF to avoid CRLF warnings on Windows
* text=auto eol=lf

# Explicitly set common text formats to LF
*.ts  text eol=lf
*.tsx text eol=lf
*.js  text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.md  text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Treat common binary assets as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
